OPENAI_API_KEY=
OPENAI_BASE_URL=https://changellenge.up.railway.app/v1
OPENAI_MODEL=qwen/qwen3.8-27b
AGENT_CONTEXT_TOKENS=262144
# Optional output floor; normal/complex defaults are 16384/32768 with adaptive growth.
AGENT_OUTPUT_TOKENS=16384
# Sampling and automatic medium/xhigh reasoning are managed by the agent.
OPENAI_EXTRA_BODY={}

# Separate direct DeepSeek-issued key, NOT the organizer team key.
# Development-only autonomous EDA; never forwarded to workers.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
